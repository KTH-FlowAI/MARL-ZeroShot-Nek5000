CASE_NAME="naca_wing"
SOURCE_ROOT=$(pwd)


# Check if an argument is provided
if [ -z "$1" ]; then
    echo "Usage: $0 [OC | PPO | DDG] "
    exit 1
fi

# Set RUN_PATH and SAVE_PATH based on input
case "$1" in
        
    DDPG_2550)
        RUN_PATH="$SOURCE_ROOT/runs/301001/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/301001/"
        SAVE_PATH="results/DDPG_2550_N11"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    
    DDPG_2570)
        RUN_PATH="$SOURCE_ROOT/runs/304001/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/304001/"
        SAVE_PATH="results/DDPG_2570_N11"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    TD3_2586)
        RUN_PATH="$SOURCE_ROOT/runs/404001/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/404001/"
        SAVE_PATH="results/TD3_2586_N11"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    
    TD3_1utau_2586)
        RUN_PATH="$SOURCE_ROOT/runs/405001/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/405001/"
        SAVE_PATH="results/TD3_1utau_2586_N11"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;

    TD3_blw_2586)
        RUN_PATH="$SOURCE_ROOT/runs/406001/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/406001/"
        SAVE_PATH="results/TD3_blw_2586_N11"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    TD3_blw_2586_5)
        RUN_PATH="$SOURCE_ROOT/runs/406005/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/406005/"
        SAVE_PATH="results/TD3_blw_2586_N11_5"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    TD3_blw_2586_2)
        RUN_PATH="$SOURCE_ROOT/runs/406002/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/406002/"
        SAVE_PATH="results/TD3_blw_2586_N11_2"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    TD3_US_2586)
        RUN_PATH="$SOURCE_ROOT/runs/601001/env_001"
        CASE_PATH="$SOURCE_ROOT/runs/601001/"
        SAVE_PATH="results/TD3_US02_2586_N11"
        LOGFILE='log-files/log-ppo-ddpg-540-025-060-N11'
        ;;
    *)
        echo "Invalid argument: $1"
        echo "Valid options: OC, PPO, DDPG"
        exit 1
        ;;
esac

# Output the selected paths (optional, for debugging)
echo "RUN_PATH: $RUN_PATH"
echo "SAVE_PATH: $SAVE_PATH"

# Make datapath
mkdir -p "$SAVE_PATH"

fileNUM=$(ls $SAVE_PATH/res_* -dq |  wc -l)
let fileNUM=fileNUM+1
DATA_PATH="$SAVE_PATH/res_"${fileNUM}
mkdir -p "$DATA_PATH"
echo "[PATH] MKDIR: $DATA_PATH"

mkdir "$DATA_PATH/la2_data"
mkdir "$DATA_PATH/sts_data"
mkdir "$DATA_PATH/pts_data"
mkdir "$DATA_PATH/rs8_data"
mkdir "$DATA_PATH/reg_data"
mkdir "$DATA_PATH/txt_data"
mkdir "$DATA_PATH/drl_data"

cp "$LOGFILE" "$DATA_PATH"
echo "[LOG] History Moved"
cp "$RUN_PATH/${CASE_NAME}.par" "$DATA_PATH"
echo "[LOG] PARAM GET"


echo "-------------------------"
echo "       Copy Data         "
echo "-------------------------"

find "$RUN_PATH" -type f -name "la2${CASE_NAME}0.f[0-9][0-9][0-9][0-9][0-9]"  -exec mv {} "$DATA_PATH/la2_data/" \;
echo "[DATA] LA2 Moved"

find "$RUN_PATH" -type f -name "pts${CASE_NAME}0.f[0-9][0-9][0-9][0-9][0-9]"  -exec mv {} "$DATA_PATH/pts_data/" \;
echo "[DATA] PTS Moved"

find "$RUN_PATH" -type f -name "sts${CASE_NAME}0.f[0-9][0-9][0-9][0-9][0-9]"  -exec mv {} "$DATA_PATH/sts_data/" \;
find "$RUN_PATH" -type f -name "c2D${CASE_NAME}0.f[0-9][0-9][0-9][0-9][0-9]"  -exec mv {} "$DATA_PATH/sts_data/" \;
echo "[DATA] STS Moved"

find "$RUN_PATH" -type f -name "${CASE_NAME}0.f[0-9][0-9][0-9][0-9][0-9]"     -exec mv {} "$DATA_PATH/reg_data/" \;
echo "[DATA] Regular Moved"

find "$RUN_PATH" -type f -name "rs8${CASE_NAME}0.f[0-9][0-9][0-9][0-9][0-9]"  -exec cp {} "$DATA_PATH/rs8_data/" \;
echo "[DATA] RS8 Moved"


echo "-------------------------"
echo "       DRL OUTPUTS       "
echo "-------------------------"
mv    ${RUN_PATH}/*txt*         ${DATA_PATH}/txt_data/
cp -r ${RUN_PATH}history/**    ${DATA_PATH}/drl_data/ 
cp -r ${RUN_PATH}logs/**    ${DATA_PATH}/drl_data/ 
mv    ${CASE_PATH}*vars_record*  ${DATA_PATH}/drl_data/
echo "[DATA] DRL Moved"

echo "########################"
echo "  Copy File Finished       "
echo "########################"
