
# maintain the folder 
/runs/**/
/data/**
# shared, de-duplicated case dependencies (mesh, .rea template, probes...)
!/data/simulations/
!/data/simulations/**
!/data/restarts/
/data/restarts/**
!/data/restarts/rs6_mini_Channel/
!/data/restarts/rs6_mini_Channel/**
!/data/policies_meta_wing_dr/
!/data/policies_meta_wing_dr/**
*mask*
!runs/readme.md
!data/readme.md
!data/restarts/rs6_mini_Channel/**/*
envs/solver/**/
!envs/solver/*tar*
/log-files/
ucx_mpi/
miniforge3/
*log*
*DATA*
/post_processing/stats/int_fld
*.o
# Python bytecode caches are interpreter/version-specific build artefacts.
__pycache__/
*.py[cod]
*RUN_PATH*
# RUN_PATH cache: keep the dir tracked, ignore its RUN_PATH_*.txt (via *RUN_PATH*)
!/.caches/
!/.caches/.gitkeep
# archived policies live in */logs/ dirs, which the generic *log* rule above
# excludes; re-include the dir first, then its contents
!/data/policies_meta_wing_dr/**/logs/
!/data/policies_meta_wing_dr/**/logs/**
