#!/bin/bash

## An initialization to prepare the folder and dependencies.
## Export the environment variables
#--------------------------------------------
# prevent the sourced shell profiles from seeing the script args (they would
# otherwise forward them to `activate`, which errors because activate expects
# only one argument)
ORIG_ARGS=("$@")
set --
source ~/.bashrc.openmpi_ucx
source ~/.bashrc.miniforge
set -- "${ORIG_ARGS[@]}"
unset OMPI_MCA_pml OMPI_MCA_osc UCX_TLS UCX_NET_DEVICES
LOG_DIR="log-files"
mkdir -p ${LOG_DIR}
export HWLOC_HIDE_ERRORS=1
export UCX_TLS=sm,self,tcp,cma,sysv,posix
export OMPI_MCA_btl=self,vader,tcp
#--------------------------------------------

#--------------------------------------------
## Configuration
# Default values
CONFIG_NAME="WING-SMALL.yml"
RUN_MODE="evaluate"

# Parse command line arguments
# Usage: ./unified-script --config [CONFIG_NAME] --run-mode [RUN_MODE] --rank [RANK]
# Parse command-line arguments after `--`
while [[ $# -gt 1 ]]; do
    case "$1" in
        --config)
            CONFIG_NAME="$2"
            shift 2
            ;;
        --run-mode)
            RUN_MODE="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
    esac
done
#--------------------------------------------

#--------------------------------------------
# I/O Initialization
mpirun -n 1 python -m meta_MARL initial ../conf/${CONFIG_NAME} > ${LOG_DIR}/log.initial.${CONFIG_NAME} 2>&1 

#--- Get the agent name and the total number of processes
# CASE_NAME=$(grep -ri 'case_name' ../conf/${CONFIG_NAME} | awk -F':' '{gsub(/ /,"",$2); print $2}')
CASE_NAME=$(grep -ri 'case_name' ../conf/${CONFIG_NAME} | sed -E "s/^[^:]*:[[:space:]]*//; s/[\"']//g; s/[[:space:]]+\$//")
NTOT=$(grep -ri 'nproc' ../conf/${CONFIG_NAME} | awk -F':' '{gsub(/ /,"",$2); print $2}')
RUN_PATH=$(head -n 1 RUN_PATH_${CASE_NAME}.txt)

if [ "$RUN_MODE" = "run" ]; then
    ENV=$(tail -n 1 RUN_PATH_${CASE_NAME}.txt)
else
    ENV=""
fi
#--------------------------------------------

echo "CONFIG: ${CONFIG_NAME}, MODE: ${RUN_MODE}, NTOT: ${NTOT}"


#--------------------------------------------
# Main execution
if [ "$RUN_MODE" = "evaluate" ]; then
    # Evaluation mode execution
    mpirun -n $((1 + ${NTOT})) bash -c "
    if [ \$OMPI_COMM_WORLD_RANK -eq 0 ]; then
        python -m meta_MARL ${RUN_MODE} ../conf/${CONFIG_NAME} 
    else
        cd ${RUN_PATH} && ./nek5000
    fi
    "  > ${LOG_DIR}/log.evaluate.${CONFIG_NAME} 2>&1 
else
    echo "RUN MODE NOT SUPPORTED"
    exit 1
fi
