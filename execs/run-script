#!/bin/bash

## An initialization to prepare the folder and dependencies.
## Export the environment variables
#--------------------------------------------
# prevent the sourced shell profiles from seeing the script args (they would
# otherwise forward them to `activate`, which errors because activate expects
# only one argument)
#[MOD] Resolve the repo root so this script can be launched from the main
#[MOD] path, e.g.  ./execs/run-script --config MC-nes-v.yml
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "${SCRIPT_DIR}")"
ORIG_ARGS=("$@")
set --
source ~/.bashrc.openmpi_ucx
source ~/.bashrc.miniforge
set -- "${ORIG_ARGS[@]}"
unset OMPI_MCA_pml OMPI_MCA_osc UCX_TLS UCX_NET_DEVICES
#[MOD] Run python from the repo root, so conf/... and save_dir=runs resolve here;
#[MOD] while logs and the RUN_PATH cache live at the repo root.
cd "${ROOT_DIR}"
LOG_DIR="${ROOT_DIR}/log-files"   #[MOD] log-files moved to the repo root
CACHE_DIR="${ROOT_DIR}/.caches"   #[MOD] RUN_PATH_*.txt cache at the repo root
mkdir -p "${LOG_DIR}" "${CACHE_DIR}"
export HWLOC_HIDE_ERRORS=1
export UCX_TLS=sm,self,tcp,cma,sysv,posix
export OMPI_MCA_btl=self,vader,tcp
#--------------------------------------------

#--------------------------------------------
## Configuration
# Default values
CONFIG_NAME="conf/MC16-TD3.yml"   #[MOD] default is now a config PATH, not a name
RUN_MODE="run"
LOAD_AGENT=""   #[MOD] override runner.load_agent (True/False) from CLI; empty = use the config value
IOSTEP=5000
writeInterval=5000
SMPSTEP=6
reward_alpha=1.0
reward_beta=1.0
reward_gamma=1.0
# Parse command line arguments
# Usage: ./unified-script --config [CONFIG_NAME] --run-mode [RUN_MODE] --rank [RANK]
# Parse command-line arguments after `--`
while [[ $# -gt 1 ]]; do
    case "$1" in
        --config)
            CONFIG_NAME="$2"
            shift 2
            ;;
        --run-mode)
            RUN_MODE="$2"
            shift 2
            ;;
        --load-agent)
            LOAD_AGENT="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
    esac
done
#--------------------------------------------
#[MOD] Resolve the config to an ABSOLUTE path (accepts a path relative to the
#[MOD] repo root, or an absolute path); fail early if it does not exist. All
#[MOD] downstream uses reference ${CONFIG_NAME} directly (no conf/ prefix).
_cfg_in="${CONFIG_NAME}"
CONFIG_NAME="$(realpath -e "${_cfg_in}" 2>/dev/null)" || {
    echo "[ERR] Config file not found: ${_cfg_in}" >&2; exit 1; }
CONFIG_TAG="$(basename "${CONFIG_NAME}")"   #[MOD] short tag for log filenames
#[MOD] Optional runner.load_agent override (switch policy loading on/off);
#[MOD] empty keeps the config value. Validate to catch typos early.
LOAD_AGENT_ARG=""
if [ -n "${LOAD_AGENT}" ]; then
    if [ "${LOAD_AGENT}" != "True" ] && [ "${LOAD_AGENT}" != "False" ]; then
        echo "[ERR] --load-agent must be True or False, got: ${LOAD_AGENT}" >&2; exit 1
    fi
    LOAD_AGENT_ARG="runner.load_agent=${LOAD_AGENT}"
fi
#--------------------------------------------

#--------------------------------------------
# I/O Initialization
mpirun -n 1 python -m nek_MARL initial ${CONFIG_NAME} > ${LOG_DIR}/log.initial.${CONFIG_TAG} 2>&1

#--- Get the agent name and the total number of processes
# AGENT_RUN_NAME=$(grep -ri 'agent_run_name' ${CONFIG_NAME} | awk -F':' '{gsub(/ /,"",$2); print $2}')
AGENT_RUN_NAME=$(grep -ri 'agent_run_name' ${CONFIG_NAME} | sed -E "s/^[^:]*:[[:space:]]*//; s/[\"']//g; s/[[:space:]]+\$//")
NTOT=$(grep -ri 'nproc' ${CONFIG_NAME} | awk -F':' '{gsub(/ /,"",$2); print $2}')
RUN_PATH=$(head -n 1 ${CACHE_DIR}/RUN_PATH_${AGENT_RUN_NAME}.txt)

if [ "$RUN_MODE" = "run" ]; then
    AGENT=$(tail -n 1 ${CACHE_DIR}/RUN_PATH_${AGENT_RUN_NAME}.txt)
else
    AGENT=""
fi
#--------------------------------------------

echo "CONFIG: ${CONFIG_NAME}, MODE: ${RUN_MODE}, NTOT: ${NTOT}"

#--------------------------------------------
#[MOD] History management is now performed inside `initial`
#[MOD] (src/initial.py:preserve_and_clean_train): before each training
#[MOD] (re)start it moves ${RUN_PATH}/history and any round* folders up into
#[MOD] runs/<agent_run_name>/history/ (as current_history + roundXXX) and then
#[MOD] wipes ./train/. The old shell-side `mv history roundXXX` is removed.

#--------------------------------------------
# Main execution
if [ "$RUN_MODE" = "evaluate" ]; then
    for ienv in {1..6}
    do
        echo "Count: $ienv"
        #[MOD] Evaluation intentionally forces reward_fn=net_gain so the eval
        #[MOD] logs all three reward components (tau/pw/v3), even for a policy
        #[MOD] trained on plain dudy. Because reward_fn drives userParam09 (the
        #[MOD] Fortran 1-vs-3 MPI buffer count), it MUST be forced HERE in the
        #[MOD] `initial` step too (this is what writes the .par), so Fortran and
        #[MOD] the Python `evaluate` call below agree. Forcing only one side
        #[MOD] desyncs the buffer count and deadlocks MPI.
        mpirun -n 1 python -m nek_MARL initial $CONFIG_NAME \
        runner.random_init=-1 \
        runner.rank=${ienv} \
        runner.reward_fn=net_gain \
        runner.reward_alpha=${reward_alpha} runner.reward_beta=${reward_beta} runner.reward_gamma=${reward_gamma} \
        runner.evaluation=True runner.learnt_policy=True \
        runner.load_agent=True \
        simulation.IOSTEP=${IOSTEP} \
        simulation.writeInterval=${writeInterval} \
	    simulation.SMPSTEP=${SMPSTEP}
       
       var=$(grep -ri 'agent_run_name' ${CONFIG_NAME} | sed -E "s/^[^:]*:[[:space:]]*//; s/[\"']//g; s/[[:space:]]+\$//")
       
       RUN_PATH=$(head -n 1 ${CACHE_DIR}/RUN_PATH_${var}.txt)
       
       # To use mpi_split, one should launch two programs at once. Therefore
       #[MOD] net_gain forced on the Python side too — MUST match the `initial`
       #[MOD] step above (same reward_fn => same userParam09 => same MPI buffer
       #[MOD] count on both Fortran and Python). Keep these two in lockstep.
       mpirun -n 1 python -m nek_MARL evaluate $CONFIG_NAME \
              runner.rank=${ienv}  runner.random_init=-1\
	          runner.reward_fn=net_gain \
	          runner.reward_alpha=${reward_alpha} runner.reward_beta=${reward_beta} runner.reward_gamma=${reward_gamma} \
              runner.evaluation=True  \
              runner.load_agent=True \
	          simulation.IOSTEP=${IOSTEP} \
	          simulation.writeInterval=${writeInterval} \
	          simulation.SMPSTEP=${SMPSTEP} : \
              -n ${NTOT} bash -c "cd ${RUN_PATH} && ./nek5000" > ${LOG_DIR}/log.run.${CONFIG_TAG} 2>&1
    done
else
    # Run mode execution
    mpirun -n $((1 + ${NTOT})) bash -c "
    if [ \$OMPI_COMM_WORLD_RANK -eq 0 ]; then
        python -m nek_MARL ${RUN_MODE} ${CONFIG_NAME} runner.policy=$AGENT ${LOAD_AGENT_ARG}
    else
        cd ${RUN_PATH} && ./nek5000
    fi
    "  > ${LOG_DIR}/log.run.${CONFIG_TAG} 2>&1 
fi
